# FinAI Edge — Express Backend Environment
# Copy to .env and fill in your values.
# This file sits at: backend/.env
# (FastAPI also reads this via env_file="../.env")

# -- Server --------------------------------------------------------
PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:9002

# -- MongoDB -------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/finai_edge

# -- Auth (JWT) ----------------------------------------------------
# IMPORTANT: Use a strong random secret, minimum 32 characters
JWT_SECRET=change_this_to_a_random_secret_minimum_32_chars
JWT_EXPIRE=30d

# -- Market Data APIs (shared with FastAPI) -----------------------
# Groww Trading API (optional - India only, paid subscription)
# IMPORTANT: variable name is GROWW_TOTP_SECRET (not GROWW_API_SECRET)
GROWW_API_KEY=
GROWW_TOTP_SECRET=

# Google Gemini AI (optional - FastAPI uses this for portfolio generation)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Finnhub market data (optional tertiary fallback)
# Get from: https://finnhub.io/dashboard
FINNHUB_API_KEY=

# -- AI Copilot (FastAPI LangGraph agent) ------------------------
# Provider switch: gemini (default, cheapest) | groq | openai/claude (placeholders)
AI_MODEL_PROVIDER=gemini
# Groq (optional secondary provider — open-source Llama models)
GROQ_API_KEY=
# Optional model overrides (defaults shown):
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# -- FastAPI connection (Express uses this for proxy/health) ------
FASTAPI_URL=http://localhost:8000
