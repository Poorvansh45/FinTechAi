PORT=8080
NODE_ENV=production
FRONTEND_URL=https://finai-edge.vercel.app

# Firebase Admin Service Account Credentials
FIREBASE_PROJECT_ID=fintech-ai-baed6
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@fintech-ai-baed6.iam.gserviceaccount.com
# Use literal \n for newlines in Render dashboard
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Market Data APIs (server-side only — NEVER expose in frontend)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Optional: MongoDB
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/finaiedge
