# FinAI Edge — FastAPI Backend Environment
# Copy to .env and fill in your keys

# ── API Keys ────────────────────────────────────────────
GROWW_API_KEY=
GROWW_TOTP_SECRET=
GEMINI_API_KEY=
FINNHUB_API_KEY=

# ── Database ────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/finai_edge

# ── Server ──────────────────────────────────────────────
FASTAPI_PORT=8000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:9002
LOG_LEVEL=INFO
